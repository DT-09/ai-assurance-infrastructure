ASSURANCE_ENV=production
ASSURANCE_BOOTSTRAP_KEY=replace-with-a-high-entropy-secret
ASSURANCE_CORS_ORIGINS=https://your-control-plane.example
ASSURANCE_TRUSTED_HOSTS=your-api.example
ASSURANCE_IDENTITY_DB=data/identity.db
ASSURANCE_CONTROL_PLANE_DB=data/control_plane.db
ASSURANCE_ASSURANCE_DB=data/assurance.db
ASSURANCE_EVIDENCE_DB=data/evidence.db
ASSURANCE_POLICY_DB=data/policies.db
ASSURANCE_TRUST_DB=data/trust.db
ASSURANCE_BILLING_DB=data/billing.db
LOG_LEVEL=INFO

# Production PostgreSQL (set this to use one shared server-grade database)
ASSURANCE_DATABASE_URL=postgresql://assurance:change-me@localhost:5432/assurance
ASSURANCE_DB_CONNECT_TIMEOUT=10

# Self-serve billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_SUCCESS_URL=https://your-domain.example/console?billing=success
STRIPE_CANCEL_URL=https://your-domain.example/pricing?billing=cancelled
