{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-assurance.dev/protocol/v1/schema.json",
  "title": "AI Assurance Protocol v1",
  "type": "object",
  "required": [
    "protocol",
    "version",
    "states",
    "decisions"
  ],
  "properties": {
    "protocol": {
      "const": "AI Assurance Protocol"
    },
    "version": {
      "const": "1.0"
    },
    "states": {
      "type": "array",
      "items": {
        "enum": [
          "ASSURED",
          "DEGRADED",
          "BLOCKED"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "enum": [
          "ALLOW",
          "REVIEW",
          "DENY"
        ]
      }
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "assurance_state": {
      "enum": [
        "ASSURED",
        "DEGRADED",
        "BLOCKED",
        "UNKNOWN",
        "EVALUATING",
        "STALE"
      ]
    },
    "evidence": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "policies": {
      "type": "array"
    },
    "provenance": {
      "type": "string"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    }
  }
}
